# Aplicación
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Base de Datos
DATABASE_URL="postgresql://postgres:password@localhost:5432/carrito_compras?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=TEST-123456789
MERCADOPAGO_CLIENT_ID=123456789
MERCADOPAGO_CLIENT_SECRET=your-client-secret
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-password
EMAIL_FROM="Tienda <noreply@tienda.com>"

# PDF
EMPRESA_NOMBRE=Mi Tienda Online
EMPRESA_RUC=20123456789
EMPRESA_DIRECCION=Av. Principal 123, Lima
EMPRESA_TELEFONO=+51 1 234-5678
EMPRESA_EMAIL=info@mitienda.com
EMPRESA_LOGO_URL=https://mitienda.com/logo.png

# Configuración de Negocio
IGV_PORCENTAJE=18
MONEDA_DEFECTO=PEN
STOCK_RESERVA_TIMEOUT=15